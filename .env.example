# Local Supabase. `npm run setup` fills these in .env.local from the local stack.
# Leave empty here: this file is committed, .env.local is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Seed script, migrations and the account-management action.
SUPABASE_SECRET_KEY=

# Demo account passwords used by the seed. Local defaults only; the live site
# uses different values, set in Vercel and never committed.
DEMO_DIRECTOR_PASSWORD=Demo1234!
DEMO_COACH_U16_PASSWORD=Demo1234!
DEMO_COACH_U18_PASSWORD=Demo1234!
DEMO_PLAYER_PASSWORD=Demo1234!
